# upstream-watch.list — what ci/upstream-check.sh monitors upstream.
#
# Two sections:
#   [CHIMERA]  chimera-linux/chimerautils (our fork parent), branch master
#   [FREEBSD]  freebsd/freebsd-src, branch main — one watched path per line
#
# Inside [FREEBSD], every non-comment non-blank line is passed to the
# GitHub commits API as path=<line>.  Everything else is documentation.
#
# The mappings follow chimera's own import-src.sh, which copies files out
# of a FreeBSD release tarball (currently 15.1-RELEASE, see upstream.conf
# in their repo).  We watch main rather than the release branch because
# it gives the earliest signal; anything relevant lands in the next
# release chimera rebases onto.  Every mapped path below was verified to
# exist in freebsd-src (2026-08, via the git trees and commits APIs).
#
# src.freebsd/ dirs that have no direct freebsd-src equivalent are listed
# at the end with a '# local:' comment; they are not queried.

[CHIMERA]

# chimera-linux/chimerautils is low-traffic, so all commits on master are
# reported without a path filter.  The areas that matter to us:
#   src.freebsd/   their FreeBSD import (same layout as ours)
#   src.custom/    their custom tools
#   include/       public headers
#   meson.build    build system
#   patches/       patches they apply to src.freebsd after import
#   import-src.sh / upstream.conf   FreeBSD release rebase tooling

[FREEBSD]

# src.freebsd/coreutils (chimera CMDS_CORE)
bin/cat
bin/chmod
bin/cp
bin/date
bin/dd
bin/df
bin/echo
bin/expr
bin/hostname
bin/ln
bin/ls
bin/mkdir
bin/mv
