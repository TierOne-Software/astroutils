usr.bin/write
# miscutils/ncal also carries an internal copy of lib/libcalendar
lib/libcalendar

# src.freebsd standalone ports
usr.bin/apply
usr.bin/bintrans
usr.bin/compress
bin/ed
usr.bin/fetch
usr.bin/gencat
usr.bin/grep
usr.bin/gzip
usr.bin/jot
usr.bin/m4
usr.bin/patch
usr.bin/sed
bin/sh
usr.bin/su
usr.bin/tip
usr.bin/which

# src.freebsd/awk is contrib/one-true-awk; usr.bin/awk supplies awk.1
contrib/one-true-awk
usr.bin/awk

# src.freebsd ports of contrib/ projects
contrib/ee
contrib/netcat
contrib/nvi
contrib/unvis
contrib/vis

# src.freebsd/telnet is contrib/telnet (minus telnetd); lib/libtelnet is
# the library build glue for the libtelnet/ copy inside it
contrib/telnet
lib/libtelnet

# src.freebsd libraries
lib/libfetch
lib/libmp
lib/libstdbuf

# src.freebsd/tip/getcap.c is copied from libc (tip's cap parser)
lib/libc/gen/getcap.c

# src.freebsd/util (public lib with pieces missing from Linux libcs)
lib/libc/gen/fts.c
lib/libc/locale/rpmatch.c

# --- not watched: dirs with no single freebsd-src equivalent ---

# local: src.freebsd/compat — chimera's porting shim library; individual
# files were cherry-picked from lib/libc (gen, stdlib, stdio, string,
# stdtime), lib/libutil, lib/libopenbsd and contrib/libc-vis and are
# maintained by hand (see import-src.sh in the chimera repo).

# local: src.freebsd/dbcompat — Berkeley db 1.85 subset (imported from
# lib/libc/db, but treated as part of the compat layer and patched
# locally; upstream lib/libc/db is effectively frozen).

# local: src.freebsd/dbinclude — db.h/mpool.h headers for dbcompat
# (from include/db.h and include/mpool.h, same situation as dbcompat).

# local: src.freebsd/include — port headers: fts.h (include/fts.h),
# vis.h (contrib/libc-vis/vis.h), ohash.h (lib/libopenbsd/ohash.h),
# stringlist.h (include/stringlist.h), rpmatch.h (chimera's own).
