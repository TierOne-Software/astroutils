usr.bin/tr
usr.bin/true
usr.bin/truncate
usr.bin/tsort
usr.bin/tty
usr.bin/uname
usr.bin/unexpand
usr.bin/uniq
usr.bin/users
usr.bin/wc
usr.bin/who
usr.bin/yes
usr.bin/xinstall
usr.sbin/chown
usr.sbin/chroot
# coreutils/factor also pulls primes.h and pr_tbl.c from usr.bin/primes
usr.bin/primes

# src.freebsd/diffutils
usr.bin/cmp
usr.bin/diff
usr.bin/diff3
usr.bin/sdiff

# src.freebsd/findutils (locate is usr.bin/locate/{bigram,code,locate})
usr.bin/find
usr.bin/xargs
usr.bin/locate

# src.freebsd/miscutils (chimera CMDS_MISC)
bin/kill
usr.bin/calendar
usr.bin/col
usr.bin/colrm
usr.bin/column
usr.bin/getopt
usr.bin/hexdump
usr.bin/indent
usr.bin/logger
usr.bin/look
