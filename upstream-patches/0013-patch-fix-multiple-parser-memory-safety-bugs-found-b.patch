 		p_char[0] = '*';
 		snprintf(buf, buf_size, "--- %ld,%ld ----\n", p_newfirst,
 		    p_newfirst + p_repl_lines - 1);
@@ -997,7 +1045,7 @@ hunk_done:
 				p_line[fillold] = s;
 				p_len[fillold++] = strlen(s);
 				if (fillold > p_ptrn_lines) {
-					if (remove_special_line()) {
