From 32461a369a6646477d4dab3b1232771ff457eb9d Mon Sep 17 00:00:00 2001
From: Michael John <mj@tierone.software>
Date: Sun, 2 Aug 2026 20:39:11 -0400
Subject: [PATCH 22/23] nvi: do not form TMAP before the screen map exists

vs_crel() ran during option initialization, before vs_screen()
allocated the map, computing TMAP = NULL + (t_rows - 1) -- pointer
arithmetic on NULL is UB (traps under zig's ReleaseSafe checks).
Only compute TMAP when the map exists; vs_screen() sets it after
allocation.
---
 src.freebsd/nvi/vi/v_z.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src.freebsd/nvi/vi/v_z.c b/src.freebsd/nvi/vi/v_z.c
index 93b946df..2dec9f68 100644
--- a/src.freebsd/nvi/vi/v_z.c
+++ b/src.freebsd/nvi/vi/v_z.c
@@ -135,7 +135,14 @@ vs_crel(SCR *sp, long int count)
 	sp->t_minrows = sp->t_rows = count;
 	if (sp->t_rows > sp->rows - 1)
 		sp->t_minrows = sp->t_rows = sp->rows - 1;
-	TMAP = HMAP + (sp->t_rows - 1);
+	/*
+	 * The map may not have been allocated yet if the window option is
+	 * being set during screen initialization; forming a pointer past
+	 * (or from) a NULL map is undefined behavior.  vs_screen() sets
+	 * TMAP after allocating the map.
+	 */
+	if (HMAP != NULL)
+		TMAP = HMAP + (sp->t_rows - 1);
 	F_SET(sp, SC_SCR_REDRAW);
 	return (0);
 }
-- 
