 src.custom/ctrlaltdel/ctrlaltdel.c   | 2 +-
 src.custom/delpart/delpart.c         | 2 +-
 src.custom/flock/flock.c             | 2 +-
 src.custom/fsfreeze/fsfreeze.c       | 2 +-
 src.custom/ionice/ionice.c           | 2 +-
 src.custom/isosize/isosize.c         | 2 +-
