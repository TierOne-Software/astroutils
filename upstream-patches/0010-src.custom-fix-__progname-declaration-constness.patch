 src.custom/realpath/realpath.cc      | 2 +-
 src.custom/resizepart/resizepart.c   | 2 +-
 src.custom/setarch/setarch.c         | 2 +-
 src.custom/setsid/setsid.c           | 2 +-
 src.custom/switch_root/switch_root.c | 2 +-
 src.custom/taskset/taskset.c         | 2 +-
 14 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/src.custom/addpart/addpart.c b/src.custom/addpart/addpart.c
index 733fa2ce..7dd8de81 100644
--- a/src.custom/addpart/addpart.c
+++ b/src.custom/addpart/addpart.c
@@ -37,7 +37,7 @@
 #include <sys/ioctl.h>
 #include <linux/blkpg.h>
 
-extern char const *__progname;
+extern char *__progname;
 /* 512-byte sectors */
 unsigned long long maxsect = ULLONG_MAX >> 9;
 
